# DeltaForceAPI key (the same one the MetaDelta bot uses). Do not commit a real key.
DELTAFORCE_API_TOKEN=
DELTAFORCE_API_BASE_URL=https://api.deltaforceapi.com

# Market tax taken from the sale price, in percent.
SELL_TAX_PERCENT=13

# Where the site listens. 127.0.0.1 = only this computer; use 0.0.0.0 on a server.
WEB_PORT=3000
WEB_HOST=127.0.0.1

# Optional: use the bot's recipe file instead of this project's copy, e.g. ../MetaDeltaBot/data/recipes.json
RECIPES_PATH=
